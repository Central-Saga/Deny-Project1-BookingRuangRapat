# ==============================================================================
# Saga MeetSpace Frontend - Environment Variables Template (Audit 496 - Issue #180)
# ==============================================================================
# Salin berkas ini ke .env.local untuk pengembangan lokal.
# ==============================================================================

# Continuous Integration flag (set to 'true' in CI environments like GitHub Actions)
CI=false

# Node environment mode (development, production, test)
NODE_ENV=development

# Next.js Public Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
