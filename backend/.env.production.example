# ==============================================================================
# Saga MeetSpace - Production Environment Configuration Template
# ==============================================================================
# Gunakan berkas ini sebagai acuan berkas .env di server produksi (CI/CD / Staging / Prod).
# Jangan commit kredensial asli ke version control.
# ==============================================================================

# 1. Application Settings
APP_NAME="Saga MeetSpace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://meetspace.example.com
APP_PREVIOUS_KEYS=""

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# 2. Authentication, Authorization & Security
BCRYPT_ROUNDS=12
AUTH_GUARD=web
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

SANCTUM_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=meetspace.example.com
SANCTUM_TOKEN_PREFIX=""

SEED_PASSWORD=

# 3. Logging & Monitoring
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=error
LOG_DAILY_DAYS=30
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=LOG_USER
LOG_PAPERTRAIL_HANDLER=null
LOG_SLACK_WEBHOOK_URL=null
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=":boom:"

PAPERTRAIL_URL=null
PAPERTRAIL_PORT=null

# 4. Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=prod-db.internal
DB_PORT=5432
DB_DATABASE=meetspace_production
DB_USERNAME=meetspace_prod_user
DB_PASSWORD=strong_production_database_password
DB_URL=null
DB_SOCKET=""
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_ENCRYPT=yes
DB_FOREIGN_KEYS=true
DB_SSLMODE=require
DB_TRUST_SERVER_CERTIFICATE=false
MYSQL_ATTR_SSL_CA=null

# 5. Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=meetspace.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_CONNECTION=default
SESSION_TABLE=sessions
SESSION_STORE=null
SESSION_COOKIE=meetspace_session
SESSION_EXPIRE_ON_CLOSE=false

# 6. Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX="meetspace_cache_"

DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=null

DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=null

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
MEMCACHED_PERSISTENT_ID=null

# 7. Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=prod-redis.internal
REDIS_PASSWORD=strong_production_redis_password
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DB=0
REDIS_URL=null
REDIS_PREFIX="meetspace_redis_"
REDIS_CLUSTER=redis
REDIS_PERSISTENT=true
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

# 8. Queue & Worker Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

DB_QUEUE=default
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE_RETRY_AFTER=90

SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=null

# 9. Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@meetspace.example.com
MAIL_PASSWORD=mailgun_smtp_password
MAIL_FROM_ADDRESS="no-reply@meetspace.example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=meetspace.example.com
MAIL_LOG_CHANNEL=null
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_URL=null
POSTMARK_MESSAGE_STREAM_ID=null

# 10. Filesystem & Object Storage (AWS S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=meetspace-prod-assets
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=null
AWS_URL=https://meetspace-prod-assets.s3.ap-southeast-1.amazonaws.com

# 11. Third Party Services
POSTMARK_API_KEY=null
RESEND_API_KEY=null
SLACK_BOT_USER_DEFAULT_CHANNEL=null
SLACK_BOT_USER_OAUTH_TOKEN=null

# 12. CORS, Frontend Integration & Activity Log
FRONTEND_URL=https://meetspace.example.com
CORS_ALLOWED_ORIGINS=https://meetspace.example.com

ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_DB_CONNECTION=null
ACTIVITY_LOGGER_TABLE_NAME=activity_log

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
