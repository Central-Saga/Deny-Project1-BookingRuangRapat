# ==============================================================================
# Saga MeetSpace - Testing Environment Configuration Template (Audit 496)
# ==============================================================================
APP_NAME=MeetSpace
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_PREVIOUS_KEYS=""

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=4
AUTH_GUARD=web
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

SANCTUM_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=""

SEED_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=1
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=LOG_USER
LOG_PAPERTRAIL_HANDLER=null
LOG_SLACK_WEBHOOK_URL=null
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=":boom:"

PAPERTRAIL_URL=null
PAPERTRAIL_PORT=null

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=:memory:
DB_USERNAME=null
DB_PASSWORD=null
DB_URL=null
DB_SOCKET=""
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_ENCRYPT=yes
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_TRUST_SERVER_CERTIFICATE=false
MYSQL_ATTR_SSL_CA=null

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_CONNECTION=null
SESSION_TABLE=sessions
SESSION_STORE=null
SESSION_COOKIE=meetspace_test_session
SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=array
CACHE_PREFIX=""

DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=null

DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=null

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
MEMCACHED_PERSISTENT_ID=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_DB=0
REDIS_URL=null
REDIS_PREFIX=""
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

DB_QUEUE=default
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE_RETRY_AFTER=90

SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=null

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=null
MAIL_LOG_CHANNEL=null
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_URL=null
POSTMARK_MESSAGE_STREAM_ID=null

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=null
AWS_URL=null

POSTMARK_API_KEY=null
RESEND_API_KEY=null
SLACK_BOT_USER_DEFAULT_CHANNEL=null
SLACK_BOT_USER_OAUTH_TOKEN=null

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_DB_CONNECTION=null
ACTIVITY_LOGGER_TABLE_NAME=activity_log

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
