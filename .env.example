# ==============================================================================
# Saga MeetSpace - Root Environment Configuration Template (Audit 496 - Issue #180)
# ==============================================================================
# Salin ke .env untuk docker compose dan setup monorepo lokal.
# ==============================================================================

# Application
APP_NAME="Saga MeetSpace"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

# PostgreSQL Database (Docker)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=meetspace_db
DB_USERNAME=meetspace_user
DB_PASSWORD=replace_with_your_local_password

# Frontend
CI=false
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Demo Seeder
SEED_PASSWORD=password
