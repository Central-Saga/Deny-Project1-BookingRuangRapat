# Saga MeetSpace - Local Development
# Copy to .env. Do not commit real credentials.

APP_NAME="Saga MeetSpace"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=meetspace_db
DB_USERNAME=meetspace_user
DB_PASSWORD=replace_with_your_local_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
